# Copy this file to secrets.yaml and fill in local values. secrets.yaml is
# intentionally ignored by Git.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
# Recovery network the bulbs join when it exists; normally not broadcast.
recovery_wifi_ssid: "gx53-recovery"
recovery_wifi_password: "CHOOSE_A_RECOVERY_PASSWORD"
